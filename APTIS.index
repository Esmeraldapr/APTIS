},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 3",
    p: "Change the dirty bed _______ and put clean ones on the mattress.",
    r: ["blankets", "cushions", "sheets", "towels"],
    c: "sheets",
    e: "Traducción: a) mantas | b) cojines | c) sábanas | d) toallas"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 3",
    p: "The dirty dishes are stacking up in the kitchen _______; please wash them.",
    r: ["bath", "dish", "sink", "lavatory"],
