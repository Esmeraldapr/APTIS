    r: ["washing machine", "dishwasher", "cooker", "microwave"],
    c: "dishwasher",
    e: "Traducción: a) lavadora | b) lavavajillas | c) fuegos de la cocina | d) microondas"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 2",
    p: "The kitchen and the living room are located _______ on the ground floor.",
    r: ["upstairs", "downstairs", "second floor", "first floor"],
