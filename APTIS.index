    e: "Traducción: a) limpieza | b) muebles | c) pasillo | d) planta de abajo"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 1",
    p: "Be careful not to touch the hot plates on the electric _______ while preparing food.",
    r: ["kettle", "cooker", "freezer", "washing machine"],
    c: "cooker",
    e: "Traducción: a) tetera | b) fuegos de la cocina | c) congelador | d) lavadora"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 1",
    p: "Walk straight down this long _______ and the restroom will be the last door on your left.",
    r: ["balcony", "corridor", "garden", "stairs"],
    c: "corridor",
    e: "Traducción: a) balcón | b) pasillo | c) jardín | d) escaleras"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 1",
    p: "Put the cereal boxes back into the kitchen _______ after you finish breakfast.",
    r: ["wardrobe", "chest of drawers", "cupboard", "bookshelf"],
    c: "cupboard",
    e: "Traducción: a) armario de ropa | b) cómoda | c) armario de cosas | d) biblioteca/estante"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 2",
    p: "This sofa is a bit hard; I think it needs a soft _______ behind my back.",
    r: ["cushion", "blanket", "sheet", "pillow"],
    c: "cushion",
    e: "Traducción: a) cojín | b) manta | c) sábana | d) almohada"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 2",
    p: "We always gather at the big wooden table in the _______ to have family dinners.",
    r: ["bathroom", "bedroom", "dining room", "lavatory"],
    c: "dining room",
    e: "Traducción: a) baño | b) dormitorio | c) comedor | d) cuarto de baño"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 2",
    p: "Put the cake on a small ceramic _______ and serve it to the guests.",
    r: ["dish", "frying pan", "kettle", "sink"],
    c: "dish",
    e: "Traducción: a) plato | b) sartén | c) tetera | d) fregadero"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 2",
