    r: ["blankets", "pillows", "rugs", "towels"],
    c: "blankets",
    e: "Traducción: a) mantas | b) almohadas | c) alfombras | d) toallas"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 1",
    p: "Pull down the _______ if the sunlight is too bright on your computer screen.",
    r: ["wall", "mirror", "blind", "plug"],
    c: "blind",
    e: "Traducción: a) pared | b) espejo | c) persiana | d) enchufe"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 1",
    p: "He has so many novels that he needs a bigger _______ to organize them.",
    r: ["bookshelf", "wardrobe", "cooker", "fridge"],
    c: "bookshelf",
    e: "Traducción: a) biblioteca/estante | b) armario de ropa | c) fuegos de la cocina | d) nevera"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 1",
    p: "The light went out because the light _______ in the kitchen burned out.",
    r: ["plug", "tap", "bulb", "mirror"],
    c: "bulb",
    e: "Traducción: a) enchufe | b) grifo | c) bombilla | d) espejo"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 1",
    p: "Look up! There is a beautiful vintage lamp hanging from the _______.",
    r: ["ground floor", "second floor", "ceiling", "stairs"],
    c: "ceiling",
    e: "Traducción: a) planta baja | b) segunda planta | c) techo | d) escaleras"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 1",
    p: "It's warm inside the house during winter thanks to the _______.",
    r: ["central heating", "frying pan", "hairdryer", "microwave"],
    c: "central heating",
    e: "Traducción: a) calefacción central | b) sartén | c) secador | d) microondas"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 1",
    p: "I keep my socks, t-shirts, and underwear inside the _______ in my bedroom.",
    r: ["cupboard", "chest of drawers", "sink", "dishwasher"],
    c: "chest of drawers",
    e: "Traducción: a) armario de cosas | b) cómoda | c) fregadero | d) lavavajillas"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 1",
    p: "Smoke was coming out of the cottage _______ as they lit the fireplace.",
    r: ["corridor", "chimney", "garage", "garden"],
    c: "chimney",
    e: "Traducción: a) pasillo | b) chimenea | c) cochera | d) jardín"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 1",
    p: "I spent the whole morning doing the _______ because the house was a mess.",
    r: ["cleaning", "furniture", "corridor", "downstairs"],
