    e: "Traducción: a) sillón | b) sofá | c) cojín | d) cama"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 3",
    p: "The elevator is broken, so we will have to walk up the _______ to the third floor.",
    r: ["corridor", "balcony", "stairs", "hall"],
    c: "stairs",
    e: "Traducción: a) pasillo | b) balcón | c) escaleras | d) entrada/recibidor"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 3",
    p: "Turn off the water _______ while soaping your face to avoid wasting water.",
    r: ["plug", "bulb", "tap", "sink"],
    c: "tap",
    e: "Traducción: a) enchufe | b) bombilla | c) grifo | d) fregadero"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 3",
    p: "Please flush the _______ after you use it and wash your hands.",
    r: ["toilet", "bath", "sink", "dishwasher"],
    c: "toilet",
    e: "Traducción: a) baño/inodoro | b) bañera | c) fregadero | d) lavavajillas"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 3",
    p: "Dry your body with a clean cotton _______ after you get out of the shower.",
    r: ["sheet", "pillow", "blanket", "towel"],
    c: "towel",
    e: "Traducción: a) sábana | b) almohada | c) manta | d) toalla"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 3",
    p: "The bedrooms are located _______ on the upper level of the duplex house.",
    r: ["downstairs", "upstairs", "ground floor", "corridor"],
    c: "upstairs",
    e: "Traducción: a) planta de abajo | b) planta de arriba | c) planta baja | d) pasillo"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 3",
    p: "We hung a colorful modern painting on the living room _______.",
    r: ["ceiling", "floor", "wall", "blind"],
    c: "wall",
    e: "Traducción: a) techo | b) suelo | c) pared | d) persiana"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 3",
    p: "Hang your suits, coats, and jackets neatly inside the bedroom _______.",
    r: ["bookshelf", "wardrobe", "cupboard", "chest of drawers"],
    c: "wardrobe",
    e: "Traducción: a) biblioteca/estante | b) armario de ropa | c) armario de cosas | d) cómoda"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 3",
    p: "The hot water runs into the ceramic _______ where you wash your face every morning.",
    r: ["sink", "washbasin", "bath", "toilet"],
    c: "washbasin",
    e: "Traducción: a) fregadero (cocina) | b) lavabo (baño) | c) bañera | d) baño/inodoro"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 3",
    p: "Put the dirty clothes inside the _______ and add some detergent.",
    r: ["dishwasher", "microwave", "washing machine", "fridge"],
    c: "washing machine",
    e: "Traducción: a) lavavajillas | b) microondas | c) lavadora | d) nevera"
}
    ];

    // Variables de Estado
    let currentQuestions = [];
    let userAnswers = {};
    let startTime;
    let timerInterval;
    let selectedBlock = "";

    // Construcción inicial del menú dinámico leyendo m, t, u
    function buildMenu() {
        const container = document.getElementById('subjects-container');
        container.innerHTML = "";

        // Agrupación por m (Materia/Bloque) -> t (Tema/Unidad) -> u (Test)
        let tree = {};
        misPreguntas.forEach((q, index) => {
            if (!tree[q.m]) tree[q.m] = {};
            if (!tree[q.m][q.t]) tree[q.m][q.t] = [];
            if (!tree[q.m][q.t].includes(q.u)) {
                tree[q.m][q.t].push(q.u);
            }
        });

        for (let m in tree) {
            let blockDiv = document.createElement('div');
            blockDiv.className = "subject-block";
            
            let title = document.createElement('h2');
            title.className = "subject-title";
            title.innerText = m;
            blockDiv.appendChild(title);

            for (let t in tree[m]) {
                let topicPara = document.createElement('p');
                topicPara.innerHTML = `<strong>${t}:</strong>`;
                blockDiv.appendChild(topicPara);

                let grid = document.createElement('div');
                grid.className = "topics-grid";

                tree[m][t].forEach(u => {
                    let btn = document.createElement('button');
                    btn.className = "menu-btn";
                    btn.innerText = u;
                    btn.onclick = () => startTest(m, t, u);
                    grid.appendChild(btn);
                });
                blockDiv.appendChild(grid);
            }
            container.appendChild(blockDiv);
        }
    }

    // Sistema de cronómetro
    function updateTimer() {
        let now = new Date();
        let diff = now - startTime;
        let mins = Math.floor(diff / 60000);
        let secs = Math.floor((diff % 60000) / 1000);
        document.getElementById('timer').innerText = `⏱️ ${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }

    // Iniciar Test convencional
    function startTest(m, t, u) {
        selectedBlock = `${m} - ${t} - ${u}`;
        currentQuestions = misPreguntas.filter(q => q.m === m && q.t === t && q.u === u);
        initLayout();
    }

    function initLayout() {
        userAnswers = {};
        document.getElementById('login-section').style.display = 'none';
        document.getElementById('results-section').style.display = 'none';
        document.getElementById('test-section').style.display = 'block';
        document.getElementById('display-topic').innerText = selectedBlock;

        startTime = new Date();
        clearInterval(timerInterval);
        timerInterval = setInterval(updateTimer, 1000);

        renderQuestions();
        window.scrollTo(0,0);
    }

    // Renderizado Dinámico de Preguntas (Distingue test común vs futuro desplegable)
    function renderQuestions() {
        const listContainer = document.getElementById('questions-list');
        listContainer.innerHTML = "";

        currentQuestions.forEach((q, index) => {
            let qIdx = misPreguntas.indexOf(q); // Índice real absoluto en el banco

            let qBlock = document.createElement('div');
            qBlock.className = "question-block";
            qBlock.id = `qblock-${qIdx}`;

            let qText = document.createElement('div');
            qText.className = "question-text";
            qText.innerText = `${index + 1}. ${q.p}`;
            qBlock.appendChild(qText);

            let optionsDiv = document.createElement('div');
            optionsDiv.className = "options-container";

            // Control Genérico: Si tiene opciones en "r", es opción múltiple habitual
            if (q.r && q.r.length > 0) {
                q.r.forEach(option => {
                    let btn = document.createElement('button');
                    btn.className = `option-btn opt-${qIdx}`;
                    btn.id = `btn-${qIdx}-${option}`;
                    btn.innerText = option;
                    btn.onclick = () => checkAnswer(qIdx, option, q.c);
                    optionsDiv.appendChild(btn);
                });

                // Inyección automática de la opción E (Traducciones fijas)
                if (q.e) {
                    let transBox = document.createElement('button');
                    transBox.className = "option-btn translation-box";
                    transBox.innerText = `E) ${q.e}`;
                    transBox.disabled = true;
                    optionsDiv.appendChild(transBox);
                }
            } else {
                // Caso Genérico: Si "r" viene vacío, monta la estructura base de un desplegable futuro
                let select = document.createElement('select');
                select.className = "select-aptis-generic";
                select.onchange = (e) => checkAnswer(qIdx, e.target.value, q.c);
                
                let defaultOpt = document.createElement('option');
                defaultOpt.value = "";
                defaultOpt.innerText = "-- Selecciona la palabra correcta (Futuro Desplegable) --";
                select.appendChild(defaultOpt);

                // Opción de prueba para mantener la reactividad del código genérico
                let mockOpt = document.createElement('option');
                mockOpt.value = q.c;
                mockOpt.innerText = q.c;
                select.appendChild(mockOpt);

                optionsDiv.appendChild(select);
            }

            qBlock.appendChild(optionsDiv);
            listContainer.appendChild(qBlock);
        });
    }

    // Validación y asignación de colores en tiempo real
    function checkAnswer(qIdx, selected, correct) {
        if (userAnswers[qIdx]) return; // Evita cambiar respuesta una vez pulsado
        userAnswers[qIdx] = selected;

        let q = misPreguntas[qIdx];
        
        if (q.r && q.r.length > 0) {
            // Bloquear botones restantes
            document.querySelectorAll(`.opt-${qIdx}`).forEach(btn => btn.disabled = true);

            if (selected === correct) {
                document.getElementById(`btn-${qIdx}-${selected}`).classList.add('correct');
            } else {
                document.getElementById(`btn-${qIdx}-${selected}`).classList.add('wrong');
                document.getElementById(`btn-${qIdx}-${correct}`).classList.add('correct');
            }
        } else {
            // Validación visual para select futuros
            let block = document.getElementById(`qblock-${qIdx}`);
            if (selected === correct) {
                block.style.borderLeft = "10px solid var(--success)";
            } else {
                block.style.borderLeft = "10px solid var(--error)";
            }
        }
    }

    // Finalizar test, evaluar porcentajes y persistir errores
    function finishTest() {
        clearInterval(timerInterval);
        let correctas = 0;
        let falladas = JSON.parse(localStorage.getItem('repaso_aptis') || '[]');

        currentQuestions.forEach(q => {
            let idx = misPreguntas.indexOf(q);
            let ans = userAnswers[idx];

            if (ans === q.c) {
                correctas++;
                // Si la acertó, la quitamos de fallos pendientes
                falladas = falladas.filter(id => id !== idx);
            } else {
                // Si erró o quedó vacía, se registra el índice
                if (!falladas.includes(idx)) falladas.push(idx);
            }
        });

        localStorage.setItem('repaso_aptis', JSON.stringify(falladas));
        updateFailedCount();

        document.getElementById('test-section').style.display = 'none';
        document.getElementById('results-section').style.display = 'block';

        document.getElementById('score-text').innerText = `${correctas}/${currentQuestions.length}`;
        let pct = ((correctas / currentQuestions.length) * 100).toFixed(1);
        document.getElementById('results-detail-text').innerText = `Has obtenido un porcentaje de acierto del ${pct}%. Las preguntas erróneas se han guardado en tu sección de repaso.`;
    }

    // Lanzar el test especial que solo filtra los fallos
    function startFailedQuestionsTest() {
        let falladas = JSON.parse(localStorage.getItem('repaso_aptis') || '[]');
        if (falladas.length === 0) {
            alert("¡Gran trabajo! No tienes ningún fallo pendiente de repaso.");
            return;
        }

        selectedBlock = "Repaso de mis Errores Guardados";
        currentQuestions = misPreguntas.filter((_, idx) => falladas.includes(idx));
        initLayout();
    }

    function updateFailedCount() {
        let falladas = JSON.parse(localStorage.getItem('repaso_aptis') || '[]');
        document.getElementById('failed-count').innerText = falladas.length;
    }

    function resetProgress() {
        if (confirm("¿Estás seguro de que deseas borrar todo tu historial de fallos guardados?")) {
            localStorage.removeItem('repaso_aptis');
            updateFailedCount();
        }
    }

    function goBackToMenu() {
        clearInterval(timerInterval);
        document.getElementById('test-section').style.display = 'none';
        document.getElementById('results-section').style.display = 'none';
        document.getElementById('login-section').style.display = 'block';
        updateFailedCount();
    }

    window.onload = function() {
        buildMenu();
        updateFailedCount();
    };
</script>

</body>
</html>