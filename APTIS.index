},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 2",
    p: "You don't need to take the stairs; my office is right here on the _______.",
    r: ["second floor", "first floor", "upstairs", "ground floor"],
    c: "first floor",
    e: "Traducción: a) segunda planta | b) primera planta | c) planta de arriba | d) planta baja"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 2",
    p: "Store the meat and ice cream in the _______ so they stay completely frozen.",
    r: ["fridge", "freezer", "cupboard", "cooker"],
    c: "freezer",
    e: "Traducción: a) nevera/frigorífico | b) congelador | c) armario de cosas | d) fuegos de la cocina"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 2",
    p: "Please put the milk, tomatoes, and yogurt back into the cold _______.",
    r: ["freezer", "cupboard", "fridge", "microwave"],
    c: "fridge",
    e: "Traducción: a) congelador | b) armario de cosas | c) nevera/frigorífico | d) microondas"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 2",
    p: "To make an omelet, you need to heat some oil in a good quality _______.",
    r: ["kettle", "dish", "sink", "frying pan"],
    c: "frying pan",
    e: "Traducción: a) tetera | b) plato | c) fregadero | d) sartén"
},
{
    m: "VOCABULARIO", t: "Unit 1: House", u: "TEST 2",
    p: "When we moved into the new flat, we had to buy new _______ like tables, chairs, and beds.",
    r: ["furniture", "cleaning", "walls", "plugs"],
